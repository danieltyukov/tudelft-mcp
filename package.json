{
  "name": "tudelft-mcp",
  "version": "0.1.1",
  "description": "MCP server for TU Delft students: Brightspace, OSIRIS (my.tudelft.nl), MyTimetable and the public Study Guide, for Claude, ChatGPT, Cursor, Codex and any other MCP client.",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Tyukov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieltyukov/tudelft-mcp.git"
  },
  "homepage": "https://danieltyukov.github.io/tudelft-mcp/",
  "bugs": {
    "url": "https://github.com/danieltyukov/tudelft-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tudelft",
    "brightspace",
    "d2l",
    "osiris",
    "mytimetable",
    "claude",
    "chatgpt",
    "cursor",
    "codex"
  ],
  "bin": {
    "tudelft-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "TUDELFT_LIVE=1 vitest run tests/live",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "docs:tools": "tsx scripts/generate-tool-docs.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.2.0",
    "fflate": "^0.8.3",
    "ical.js": "^2.2.1",
    "mammoth": "^1.12.3",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.0",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
